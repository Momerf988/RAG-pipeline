# Copy this file to .env and fill in your own values. .env is gitignored on purpose --
# never commit real API keys.

# Chat completion endpoint (OpenAI-compatible). Works with Groq, OpenRouter, or OpenAI
# directly, just point LLM_SERVER_URL at whichever one you're using.
LLM_API_KEY=
LLM_SERVER_URL=
LLM_MODEL_NAME=llama-3.1-8b-instant

# Declared for completeness, not currently read by any script -- the CRAG evaluator model
# and the RAGAS judge model are both set directly in code (config.EVALUATOR_MODEL_NAME in
# config.py, and gpt-4o-mini in 09_run_ragas_evaluation.py) rather than through this var.
JUDGE_MODEL_NAME=

# Pinecone
DB_API_KEY=
DB_INDEX_NAME=

# Sentence-transformers embedding model
TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Local corpus folder
PDF_DIRECTORY=pdf_files

# OpenAI key, used only for RAGAS judging (gpt-4o-mini)
OPENAI_API_KEY=
